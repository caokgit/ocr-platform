#!/usr/bin/env python3
"""Commit message rules (AGENTS.md).

1. Rule 0: a commit that changes implementation paths names the spec it implements with a trailer
   `Spec: docs/<file>.md#<anchor>`; the file must exist and the anchor must match a heading.
   Docs-only commits pass without it.
2. No AI attribution lines (Co-Authored-By, "Generated with").

Enable once per clone: git config core.hooksPath tools/hooks
"""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                           check=True).stdout.strip())
IMPLEMENTATION = ("infra/", "pipelines/", "services/", "tools/")
ATTRIBUTION = re.compile(r"(?im)^(co-authored-by:|.*generated with \[?claude)")


def slug(heading):
    return re.sub(r"[^\w\- ]", "", heading.strip().lower().replace("`", "")).replace(" ", "-")


def headings(path):
    text = re.sub(r"```.*?```", "", path.read_text(), flags=re.S)
    return {slug(h) for h in re.findall(r"^#+\s+(.*)$", text, re.M)}


def main(message_file):
    message = Path(message_file).read_text()
    message = "\n".join(line for line in message.splitlines() if not line.startswith("#"))
    problems = []
    if ATTRIBUTION.search(message):
        problems.append("AI attribution line (Co-Authored-By / Generated with): remove it")

    staged = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True,
                            text=True, check=True).stdout.split()
    touched = [f for f in staged if f.startswith(IMPLEMENTATION)]
    if touched:
        specs = re.findall(r"(?m)^Spec:\s*(\S+)\s*$", message)
        if not specs:
            problems.append("implementation paths changed but no 'Spec: docs/<file>.md#<anchor>' trailer")
        for spec in specs:
            path, _, anchor = spec.partition("#")
            target = ROOT / path
            if not target.is_file():
                problems.append(f"Spec file not found: {path}")
            elif not anchor:
                problems.append(f"Spec trailer without an #anchor: {spec}")
            elif anchor not in headings(target):
                problems.append(f"Spec anchor not found: {spec}")

    if problems:
        print("commit-msg (AGENTS.md):", file=sys.stderr)
        for f in touched[:10]:
            print(f"  changed: {f}", file=sys.stderr)
        for p in problems:
            print(f"  -> {p}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
