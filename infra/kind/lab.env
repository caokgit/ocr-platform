# Sourced by the kind scripts: the isolated configs (AGENTS.md, "every tool login gets its own folder").
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
export KUBECONFIG=$REPO/.scratch_kube/kind.yaml
export HELM_CACHE_HOME=$REPO/.scratch_helm/cache HELM_CONFIG_HOME=$REPO/.scratch_helm/config HELM_DATA_HOME=$REPO/.scratch_helm/data
export PATH=$REPO/.toolchain/bin:$PATH
CLUSTER=ocr-lab
GIT_MIRROR=$REPO/.scratch_lab/git/ml-init.git
